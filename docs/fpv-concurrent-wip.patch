+  for (const d of deeds()) for (const kind of ['home', 'shop']) {
+    if (!d[kind]) continue;
+    const [tx, ty] = d[kind].split(',').map(Number);
+    if (Number.isFinite(tx)) env.deedMap.set(tx + ',' + ty, { name: d.name, kind });
+  }
+  collectBuildings(bb, env);
+  collectAgents(env);
+  collectWalkers(env);
+  drawables.sort((a, b) => b.d - a.d);
