+    }
+  } else if (id === 'eid') {
+    for (let i = 0; i < 5; i++) {
+      const ph = (t * 0.05 + i / 5) % 1;
+      const x = W * (0.12 + 0.19 * i) + Math.sin(t + i) * 8;
+      const y = cam.horizon * 0.7 - ph * H * 0.25;
+      ctx.fillStyle = ['#f57f17', '#00897b', '#c62828', '#7b1fa2', '#e8850c'][i];
+      ctx.beginPath(); ctx.ellipse(x, y, 4.5, 6, 0, 0, 7); ctx.fill();
