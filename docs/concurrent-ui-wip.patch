+
+/* ================= v5 true first-person HUD (issue #23) ================= */
+
+/* centre reference — a whisper, not a target */
+#crosshair {
+  position: fixed; left: 50%; top: 50%;
+  width: 5px; height: 5px; margin: -2.5px 0 0 -2.5px;
+  border-radius: 50%;
+  background: rgba(255, 236, 200, .85);
+  box-shadow: 0 0 0 2px rgba(16, 13, 8, .28), 0 0 10px rgba(255, 176, 58, .35);
+  z-index: 22; pointer-events: none;
+  display: none;
+}
+body.walking #crosshair { display: block; }
+
+/* pocket map: roads, deed homes and the marigold you */
+.walk-map {
+  position: fixed; right: 10px;
+  top: calc(var(--hud-h) + env(safe-area-inset-top) + 14px);
+  width: 124px; height: 124px;
+  border-radius: 14px;
+  border: 1px solid var(--chrome-edge);
+  box-shadow: var(--shadow-soft);
+  z-index: 21; display: none;
+}
+body.walking .walk-map { display: block; }
+@media (max-width: 719px) { .walk-map { width: 92px; height: 92px; top: auto; bottom: 178px; } }
+
+/* first-time look hint, retires itself */
+.look-hint {
+  position: fixed; left: 50%; transform: translateX(-50%);
+  bottom: calc(150px + env(safe-area-inset-bottom));
+  background: var(--chrome); color: var(--ink);
+  border: 1px solid var(--chrome-edge);
+  border-radius: 999px; padding: 8px 16px;
+  font-size: 13px; font-weight: 600; white-space: nowrap;
+  box-shadow: var(--shadow-soft);
+  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
+  z-index: 22; pointer-events: none;
+  display: none;
+}
+body.walking .look-hint[hidden] { display: none; }
+body.walking .look-hint:not([hidden]) { display: block; }
+@media (max-width: 719px) { .look-hint { bottom: 226px; font-size: 12px; max-width: 92vw; white-space: normal; text-align: center; } }
